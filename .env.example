# ─── Docker Compose (repo root) ──────────────────────────────────────────────
# `docker compose` reads this file and hands each value to the service that needs it.
#   cp .env.example .env     (git-ignored)
# Per-service files for running without Docker: api/.env.example and frontend/.env.example.

# REQUIRED. Shared secret between the web app's server side and the API (header X-Api-Key).
# Must be identical for both services; the API rejects short or well-known values in production.
# Generate: openssl rand -hex 32
ADMIN_API_KEY=

# REQUIRED. Signs the browser session cookie (frontend only). At least 32 characters.
# Generate: openssl rand -hex 32   (use a different value than ADMIN_API_KEY)
SESSION_SECRET=

# Web app address as seen from your PHONE. Encoded into the pairing QR code on the display.
# Use the LAN IP of the machine running the stack, or your public https:// domain.
PUBLIC_APP_URL=http://192.168.1.100:7777

# ─── Optional ────────────────────────────────────────────────────────────────
# Database (compose creates it; defaults shown). Change the password for anything not on your LAN.
# POSTGRES_USER=postgres
# POSTGRES_PASSWORD=postgres
# POSTGRES_DB=public_transport_spy

# Port the API is published on (host side).
# PORT=7778

# true once the app is served over HTTPS. Browsers discard Secure cookies on plain http://<LAN-IP>,
# so this must stay false (default) for a LAN-only setup, otherwise login silently fails.
# COOKIE_SECURE=false
# Share the login cookie across subdomains, e.g. .example.com. Leave empty otherwise.
# COOKIE_DOMAIN=

# true when ONE reverse proxy (nginx, Caddy, Cloudflare) sits in front of the stack and overwrites
# X-Forwarded-For with the real client IP. Applies to the API AND the frontend (compose passes it to
# both): rate limiting then sees real client IPs. Leave false if clients connect directly, otherwise
# anyone can forge their IP. Details: docs/deployment.md section 5.
# TRUST_PROXY=false

# Move every paired display to a new API address on its next poll (domain change without reflashing).
# DEVICE_BACKEND_URL=https://api.example.com
