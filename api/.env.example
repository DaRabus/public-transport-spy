# NestJS API: used by `npm run dev:api`, `npm run seed` and the migration scripts.
# Validated at startup (api/src/modules/shared-modules/config/env.validation.ts).
# With Docker Compose these values come from the root .env instead.

# development | production | test. Production: JSON logs, Swagger off, strict ADMIN_API_KEY check.
NODE_ENV=development

# Port the API listens on.
PORT=7778

# PostgreSQL 18 connection string. Port 4700 is the host port of `docker compose up -d pts-postgres`.
DATABASE_URL=postgres://postgres:postgres@localhost:4700/public_transport_spy

# Shared secret for admin routes (header X-Api-Key); must equal the frontend's ADMIN_API_KEY.
# The value below is only accepted outside production. In production use `openssl rand -hex 32`.
ADMIN_API_KEY=dev-admin-secret-key-change-in-prod

# Web app address as seen from the phone that scans the display's QR code (<URL>/pair?code=...).
# Use your LAN IP, not localhost.
PUBLIC_APP_URL=http://192.168.1.100:7777

# ─── Optional ────────────────────────────────────────────────────────────────
# true/false. Serves Swagger UI at /docs. Default: on in development, off in production.
# ENABLE_SWAGGER=true

# true behind a single reverse proxy that overwrites X-Forwarded-For, so per-IP rate limits see real
# device IPs. Keep it equal to the frontend's TRUST_PROXY. Default false. See docs/deployment.md section 5.
# TRUST_PROXY=false

# Move every device to a new API base URL on its next config poll (checked via /hello first).
# DEVICE_BACKEND_URL=https://api.example.com

# Only for `npm run test:integration`: database to test against (default: public_transport_spy_test
# on the local pts-postgres container). Never point this at your real database.
# INTEGRATION_DATABASE_URL=postgres://postgres:postgres@localhost:4700/public_transport_spy_test
