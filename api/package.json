{
  "name": "public-transport-spy",
  "version": "2.0.1",
  "description": "NestJS API for the Public Transport Spy departure board: device pairing, screen composition and Swiss timetable data",
  "keywords": [
    "esp32",
    "ssd1322",
    "oled",
    "public-transport",
    "departure-board",
    "transit",
    "swiss-public-transport",
    "diy",
    "iot",
    "platformio",
    "nestjs",
    "nextjs",
    "self-hosted",
    "sbb",
    "cff",
    "ffs",
    "swiss-federal-railways",
    "schweizerische-bundesbahnen",
    "switzerland"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DaRabus/public-transport-spy.git"
  },
  "homepage": "https://github.com/DaRabus/public-transport-spy#readme",
  "bugs": {
    "url": "https://github.com/DaRabus/public-transport-spy/issues"
  },
  "private": true,
  "scripts": {
    "build": "nest build",
    "start": "node dist/main.js",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "typeorm": "typeorm-ts-node-commonjs -d src/modules/database/data-source.ts",
    "migration:generate": "typeorm-ts-node-commonjs migration:generate -d src/modules/database/data-source.ts",
    "migration:run": "typeorm-ts-node-commonjs migration:run -d src/modules/database/data-source.ts",
    "seed": "ts-node src/modules/database/seeds/seed.ts",
    "migration:revert": "typeorm-ts-node-commonjs migration:revert -d src/modules/database/data-source.ts",
    "test:integration": "jest --config ./test/integration/jest-integration.json --runInBand",
    "migration:check": "typeorm-ts-node-commonjs migration:generate src/modules/database/migrations/Drift -d src/modules/database/data-source.ts --check"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": [
        "ts-jest",
        {
          "tsconfig": "<rootDir>/../tsconfig.json"
        }
      ]
    },
    "testEnvironment": "node"
  },
  "dependencies": {
    "@nestjs/common": "11.2.7",
    "@nestjs/config": "4.0.4",
    "@nestjs/core": "11.2.7",
    "@nestjs/platform-express": "11.2.7",
    "@nestjs/swagger": "11.4.7",
    "@nestjs/throttler": "6.7.1",
    "@nestjs/typeorm": "11.0.3",
    "bcryptjs": "3.0.3",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "nestjs-pino": "4.6.1",
    "pg": "8.23.1",
    "pino-http": "11.0.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "typeorm": "1.1.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@faker-js/faker": "10.6.0",
    "@nestjs/cli": "11.0.24",
    "@nestjs/testing": "11.2.7",
    "@types/express": "5.0.6",
    "@types/jest": "30.0.0",
    "@types/node": "24.19.2",
    "@types/supertest": "7.2.1",
    "jest": "30.5.2",
    "pino-pretty": "13.2.0",
    "supertest": "7.3.1",
    "ts-jest": "29.4.15",
    "ts-node": "10.9.2",
    "typescript": "6.0.3"
  }
}
