# Next.js dashboard + BFF: used by `npm run dev:frontend`.
# With Docker Compose these values come from the root .env instead.
# Server-side only (no NEXT_PUBLIC_ prefix) means the browser never sees the value.

# Port is set by the npm scripts / Dockerfile (7777); override with PORT=... if needed.

# Where the Next.js SERVER reaches the API. Takes precedence over NEXT_PUBLIC_API_URL.
# Docker: http://pts-api:7778   Local dev: http://localhost:7778
INTERNAL_API_URL=http://localhost:7778

# Fallback API address when INTERNAL_API_URL is unset. Exposed to the browser; never put secrets here.
NEXT_PUBLIC_API_URL=http://localhost:7778

# Must equal the API's ADMIN_API_KEY. Added by the server-side proxy; never sent to the browser.
# The value below is only used outside production (in production there is no fallback).
ADMIN_API_KEY=dev-admin-secret-key-change-in-prod

# Signs the session cookie. Required in production, at least 32 characters (openssl rand -hex 32).
# The value below is rejected in production.
SESSION_SECRET=dev-session-secret-change-in-production-123456

# ─── Optional ────────────────────────────────────────────────────────────────
# Set to false to allow login over plain http:// in production mode (LAN without HTTPS).
# Default: true in production, false in development.
# COOKIE_SECURE=true

# Cookie domain for sharing the login across subdomains, e.g. .example.com. Default: current host.
# COOKIE_DOMAIN=

# true behind a single reverse proxy that overwrites X-Forwarded-For: the login throttle then uses the
# real browser IP. Keep it equal to the API's TRUST_PROXY. Default false. See docs/deployment.md section 5.
# TRUST_PROXY=false

# Extra hostnames/IPs allowed to load the dev server (e.g. your phone via LAN IP), comma separated.
# DEV_ORIGINS=192.168.1.20
